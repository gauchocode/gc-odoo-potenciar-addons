<odoo noupdate="1">
<record id="ir_cron_bna_currency_rate" model="ir.cron">
    <field name="name">Actualizar cotizaciones de monedas</field>
    <field name="model_id" ref="base.model_res_company"/>
    <field name="state">code</field>
    <field name="code">model.search([]).update_currency_rates_from_providers()</field>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
    <field name="numbercall">-1</field>
    <field name="active">True</field>
</record>
</odoo>
